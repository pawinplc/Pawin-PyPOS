# PyPOS Backend Environment Variables
# Copy this file to .env

# Local development database (SQLite). Resolved from the directory you start
# uvicorn in, so run it from backend/.
DATABASE_URL=sqlite:///./pypos_dev.db

# Production / MySQL alternative:
# DATABASE_URL=mysql+pymysql://pypos:PyPosSecret2026!@127.0.0.1:3306/pypos

# Server Configuration
HOST=0.0.0.0
PORT=8001
